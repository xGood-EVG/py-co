#: mood/server/__init__.py:299
msgid "{name} died"
msgstr "{name} умер"

#: mood/server/__init__.py:300
msgid "Found {name}"
msgstr "Обнаружен {name}"

#: mood/server/__init__.py:301
msgid "{name} now has {hp} hitpoint"
msgid_plural "{name} now has {hp} hitpoints"
msgstr[0] "{name} теперь имеет {hp} очко здоровья"
