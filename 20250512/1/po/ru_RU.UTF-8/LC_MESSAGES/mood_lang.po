msgid "{name} moved one cell {dir}"
msgstr "{name} переместился на одну клетку {dir}"

#: mood/server/__init__.py:303
msgid "Login already in use!"
msgstr "Логин уже используется!"

#: mood/server/__init__.py:304
msgid "User {login} logged in"
