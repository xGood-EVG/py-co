#: mood/server/__init__.py:295
msgid "Moved to ({x}, {y})"
msgstr "Перемещение в ({x}, {y})"

#: mood/server/__init__.py:296
msgid "No {name} here"
msgstr "Здесь нет {name}"

#: mood/server/__init__.py:297
msgid "User {login} added monster {name} to ({x}, {y}) saying {msg}"
msgstr "Игрок {login} добавил монстра {name} в поле ({x}, {y}) говорящего {msg}"

#: mood/server/__init__.py:298
msgid "User {login} attacked {name}, damage {dmg}"
